# ==============================================================================
# Antigravity on GCP Environment Configuration
# ==============================================================================

# GCP Project Settings
GCP_PROJECT_ID=cloud-execution-environment
GCP_REGION=us-west1
GCP_ZONE=us-west1-b

# Compute Engine Instance Settings (Always Free Eligible)
GCP_INSTANCE_NAME=agy-runner-vm
GCP_MACHINE_TYPE=e2-micro
GCP_BOOT_DISK_SIZE=30GB
GCP_BOOT_DISK_TYPE=pd-standard
GCP_IMAGE_FAMILY=ubuntu-2404-lts-amd64
GCP_IMAGE_PROJECT=ubuntu-os-cloud

# VM User Settings
RUNNER_USER=runner
SWAP_SIZE_GB=2

# Antigravity CLI Settings
AGY_VERSION=1.4.10
AGY_CLI_DISABLE_AUTO_UPDATE=true

# GitHub Actions Runner Settings
# Comma-separated list of repositories (owner/repo)
TARGET_REPOS=aegisfleet/tool-survey-report,aegisfleet/amazon-product-article
